# Kopiér denne fil til ".env" og udfyld værdierne.
# Disse er KUN server-side (læses af /api funktionerne) og bliver aldrig sendt til browseren.

# --- Database (Turso) ------------------------------------------------
# I produktion sætter Vercels Turso-integration begge. Lokalt kan det være en fil:
# TURSO_DATABASE_URL=file:C:/sti/til/smsalert.db   (opret tabellerne med npm run db:migrate)
TURSO_DATABASE_URL=libsql://smsalert-xxx.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=din-turso-nøgle

# --- Login (Better Auth) ---------------------------------------------
# En lang tilfældig værdi, fx: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=lang-tilfældig-værdi

# --- GatewayAPI (https://gatewayapi.com) ------------------------------
# API-token oprettes under "API-nøgler".
GATEWAYAPI_TOKEN=din-gatewayapi-token
# Afsendernavn vist på SMS'en (max 11 tegn, bogstaver). Kan også styres i Indstillinger.
GATEWAYAPI_SENDER=Restaurant
# Lokalt: 1 = send aldrig SMS (tør kørsel). Virker aldrig på Vercel.
SMS_DRY_RUN=1

# --- Landekode --------------------------------------------------------
# Bruges når et 8-cifret nummer indtastes uden landekode (45 = Danmark).
DEFAULT_COUNTRY_CODE=45

# --- Kun under flytningen fra Supabase (november 2026) ----------------
# Postgres-forbindelsen til npm run copy-from-supabase. Fjernes efter flytningen.
SUPABASE_DB_URL=postgresql://postgres.dit-projekt:DIT-DB-PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
